# SplitMate Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database URL (e.g., Supabase transaction pooler or direct connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/splitmate?schema=public"

# Supabase Credentials (optional for direct DB access, used for Supabase Auth / Storage if configured)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT Authentication
JWT_SECRET="splitmate-super-secret-jwt-key-2026-fintech"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="*"
